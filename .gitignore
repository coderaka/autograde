# OS
.DS_Store

# Student submissions (privacy — don't commit student work)
submissions/*
!submissions/.gitkeep
!submissions/hw*/.gitkeep

# Rubrics content (course-specific, not shared publicly)
rubrics/*
!rubrics/.gitkeep
!rubrics/hw*/.gitkeep

# Grading results (generated, contains student data)
results/*
!results/.gitkeep
!results/hw*/.gitkeep

# Environment
.env
